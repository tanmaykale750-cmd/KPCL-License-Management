# Copy this file to `.env` (same folder) and fill in ONE provider.  Never commit `.env`.
#   PowerShell:  Copy-Item .env.example .env ; notepad .env

# auto      = use Anthropic if ANTHROPIC_API_KEY is set, else OpenAI if OPENAI_API_KEY is set, else no LLM
# anthropic | openai | none   (none = retrieval-only mode: answers show the retrieved facts, no AI summary)
LLM_PROVIDER=auto

# --- Option A: Anthropic Claude  (key from https://console.anthropic.com -> API Keys)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# ANTHROPIC_API_URL=https://api.anthropic.com

# --- Option B: OpenAI, or any OpenAI-compatible server (Groq, OpenRouter, Together, Ollama, LM Studio, ...)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
#   Groq:       LLM_PROVIDER=openai  OPENAI_BASE_URL=https://api.groq.com/openai/v1  OPENAI_MODEL=openai/gpt-oss-120b  MAX_TOKENS=2500
#               (use a model listed for YOUR account at console.groq.com; put each setting on its own line)
#   Ollama:     OPENAI_BASE_URL=http://localhost:11434/v1           OPENAI_MODEL=llama3.1   OPENAI_API_KEY=ollama
#   LM Studio:  OPENAI_BASE_URL=http://localhost:1234/v1            OPENAI_API_KEY=lm-studio

# --- Forecasting model: ensemble (default: the model selected by the light-model comparison)
#     or single (the original single gradient-boosted model)
# FORECAST_MODEL=ensemble

# --- Optional tuning (defaults are in config/settings.json)
# TEMPERATURE=0.2
# MAX_TOKENS=1200
# TOP_K=8
# HISTORY_TURNS=6
# REQUEST_TIMEOUT_S=60
# REWRITE_FOLLOWUPS_WITH_LLM=true
