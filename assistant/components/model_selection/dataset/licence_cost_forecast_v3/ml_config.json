    "portfolio_other_planned_load_target",
    "portfolio_peak_last_30d",
    "portfolio_peak_last_90d",
    "months_to_next_renewal",
    "target_month_after_next_renewal",
    "portfolio_headroom_last_30d",
    "portfolio_planned_load_to_owned_ratio"
  ]
