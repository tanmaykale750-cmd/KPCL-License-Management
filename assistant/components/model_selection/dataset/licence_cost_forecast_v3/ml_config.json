  "categorical_features": [
    "software_id",
    "department",
    "project_priority",
    "plan_phase_at_cutoff",
    "plan_phase_in_target_month"
  ],
  "targets": {
    "licence_count": "target_licences_required (regression)",
    "licence_class": "target_requirement_class (classification)",
    "monthly_cost": "target_monthly_licence_cost_inr (regression)",
    "optimal_cost": "target_cost_optimal_inr (regression)",
    "portfolio_peak": "target_portfolio_peak_demand (regression, licences needed on the shared pool)",
    "shortfall": "target_portfolio_shortfall_licences (regression) / target_portfolio_shortfall_flag (binary)",
    "shortfall_cost": "target_shortfall_cost_optimal_inr (regression)",
    "idle_cost": "target_idle_licence_cost_month_inr (regression)"
  },
  "cost_rule": {
    "buy_annual_cost": "licences x annual_cost_per_licence_inr",
    "temporary_cost": "licences x temporary_monthly_cost_per_licence_inr x months_need_from_target_to_deadline",
    "choose": "buy annual if months_need_from_target_to_deadline >= breakeven_months_temp_vs_annual (7.5), else temporary; prices in lookups/software_lookup.csv"
  },
  "never_use_as_features": [
    "target_licences_required",
    "target_monthly_licence_cost_inr",
    "target_cost_optimal_inr",
    "target_requirement_class",
    "target_avg_daily_peak",
    "target_portfolio_peak_demand",
    "target_portfolio_shortfall_licences",
    "target_portfolio_shortfall_flag",
    "target_shortfall_cost_optimal_inr",
    "target_idle_licence_cost_month_inr",
    "row_id",
    "project_id",
    "portfolio_id",
    "split",
    "sample_weight",
    "project_start_date",
    "project_deadline_date",
    "cutoff_date",
    "target_month_start"
  ],
  "group_column": "portfolio_id",
  "split_column": "split",
  "weight_column": "sample_weight",
  "note": "Split by portfolio (all projects of a portfolio share a split). Software prices/owned licences live in lookups/software_lookup.csv (join on software_id).",
  "new_in_v3_features": [
    "licences_owned_for_software",
    "plan_peak_load_target",
    "plan_max_phase_intensity_target",
    "plan_n_phases_target",
    "plan_load_last_observed_month",
    "obs_peak_per_plan_load_last",
    "plan_load_change_vs_last_month",
    "est_target_peak_from_last_ratio",
